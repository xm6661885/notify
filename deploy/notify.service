[Unit]
Description=notify web push service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=notify
Group=notify
WorkingDirectory=/opt/notify
Environment=HOME=/opt/notify
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PYTHONUNBUFFERED=1
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
ExecStart=/opt/notify/.venv/bin/python -m server
Restart=always
RestartSec=3
UMask=0077
MemoryMax=300M

[Install]
WantedBy=multi-user.target
